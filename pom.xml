<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>nl.hauntedmc.platform</groupId>
        <artifactId>haunted-library-parent</artifactId>
        <version>1.5.0</version>
        <relativePath/>
    </parent>

    <groupId>nl.hauntedmc.dataprovider</groupId>
    <artifactId>dataprovider-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>DataProvider</name>
    <description>Plugin-scoped data access infrastructure for Velocity and Paper.</description>
    <url>https://github.com/HauntedMC/DataProvider</url>

    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>HauntedMC</id>
            <name>HauntedMC</name>
            <url>https://www.hauntedmc.nl</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/HauntedMC/DataProvider.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/HauntedMC/DataProvider.git</developerConnection>
        <url>https://github.com/HauntedMC/DataProvider</url>
        <tag>v3.4.2</tag>
    </scm>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages - DataProvider</name>
            <url>https://maven.pkg.github.com/HauntedMC/DataProvider</url>
        </repository>
    </distributionManagement>

    <modules>
        <module>dataprovider-api</module>
        <module>dataprovider-core</module>
        <module>dataprovider-platform-common</module>
        <module>dataprovider-platform-paper</module>
        <module>dataprovider-platform-velocity</module>
    </modules>

    <properties>
        <!-- Project identity and compiler configuration. -->
        <revision>3.4.2</revision>

        <!-- Platform APIs and production dependencies. -->
        <paper.version>26.2.build.112-stable</paper.version>
        <paper.runtime.version>26.2</paper.runtime.version>
        <paper.runtime.build>65</paper.runtime.build>
        <paper.runtime.sha256>d290ee2a3ae92fea10afb0c74f797023d74cfd72cbcee44314e0c50d5551f2c6</paper.runtime.sha256>
        <velocity.version>4.1.0-SNAPSHOT</velocity.version>
        <velocity.runtime.build>9</velocity.runtime.build>
        <velocity.runtime.sha256>635ffe27b4fe1b97e61479012121d4e7c61a9eec99e6bd5a1f923053c2a259ce</velocity.runtime.sha256>
        <adventure.version>${haunted.adventure.version}</adventure.version>
        <hauntedmc-theme.version>1.0.0</hauntedmc-theme.version>
        <configurate.version>${haunted.configurate.version}</configurate.version>
        <mysql.version>26.7.0</mysql.version>
        <hikari.version>7.1.0</hikari.version>
        <mongodb.driver.version>5.10.0</mongodb.driver.version>
        <jedis.version>8.0.0</jedis.version>
        <hibernate.version>${haunted.hibernate.version}</hibernate.version>
        <jakarta.persistence.version>${haunted.jpa.version}</jakarta.persistence.version>
        <jakarta.xml.bind.version>${haunted.jaxb.api.version}</jakarta.xml.bind.version>
        <jaxb.runtime.version>${haunted.jaxb.runtime.version}</jaxb.runtime.version>
        <jboss.logging.version>${haunted.jboss.logging.version}</jboss.logging.version>
        <errorprone.annotations.version>${haunted.errorprone.version}</errorprone.annotations.version>
        <jetbrains.annotations.version>${haunted.jetbrains.annotations.version}</jetbrains.annotations.version>
        <jspecify.version>${haunted.jspecify.version}</jspecify.version>
        <slf4j.version>${haunted.slf4j.version}</slf4j.version>
        <gson.version>${haunted.gson.version}</gson.version>

        <!-- Test libraries. -->
        <junit.version>${haunted.junit.version}</junit.version>
        <mockito.version>${haunted.mockito.version}</mockito.version>
        <build.helper.maven.plugin.version>3.6.1</build.helper.maven.plugin.version>
    </properties>

    <repositories>
        <!-- Resolve public artifacts from Central before platform-specific repositories. -->
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/HauntedMC/*</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository><id>github</id><url>https://maven.pkg.github.com/HauntedMC/*</url></pluginRepository>
    </pluginRepositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-coverage-minimum</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.15</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.basepom.maven</groupId>
                <artifactId>duplicate-finder-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>reject-duplicate-classes</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <failBuildInCaseOfDifferentContentConflict>true</failBuildInCaseOfDifferentContentConflict>
                            <failBuildInCaseOfEqualContentConflict>true</failBuildInCaseOfEqualContentConflict>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- JaCoCo supplies argLine late; Mockito must be loaded as an agent before tests start on JDK 25. -->
                        <argLine>@{argLine} -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar --enable-native-access=ALL-UNNAMED</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- Release-only consumers compile against the public API and are exercised inside real platform processes. -->
        <profile>
            <id>platform-acceptance</id>
            <modules>
                <module>dataprovider-platform-acceptance</module>
            </modules>
        </profile>
    </profiles>
</project>
