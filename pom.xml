<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>nl.hauntedmc.platform</groupId>
        <artifactId>haunted-library-parent</artifactId>
        <version>2.0.0</version>
        <relativePath/>
    </parent>

    <groupId>nl.hauntedmc.dataprovider</groupId>
    <artifactId>dataprovider-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>DataProvider</name>
    <description>Plugin-scoped data access infrastructure for Velocity and Paper.</description>
    <url>https://github.com/HauntedMC/DataProvider</url>

    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>HauntedMC</id>
            <name>HauntedMC</name>
            <url>https://www.hauntedmc.nl</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/HauntedMC/DataProvider.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/HauntedMC/DataProvider.git</developerConnection>
        <url>https://github.com/HauntedMC/DataProvider</url>
        <tag>v3.4.5</tag>
    </scm>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages - DataProvider</name>
            <url>https://maven.pkg.github.com/HauntedMC/DataProvider</url>
        </repository>
    </distributionManagement>

    <modules>
        <module>dataprovider-bom</module>
        <module>dataprovider-api</module>
        <module>dataprovider-core</module>
        <module>dataprovider-platform-common</module>
        <module>dataprovider-platform-paper</module>
        <module>dataprovider-platform-velocity</module>
    </modules>

    <properties>
        <!-- Compatibility target for the optional Theme integration. -->
        <haunted.theme.version>1.2.2</haunted.theme.version>
        <!-- Project identity and compiler configuration. -->
        <revision>3.4.5</revision>

        <!-- Build tooling specific to DataProvider. -->
    </properties>

    <repositories>
        <!-- Resolve public artifacts from Central before platform-specific repositories. -->
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/HauntedMC/*</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository><id>github</id><url>https://maven.pkg.github.com/HauntedMC/*</url></pluginRepository>
    </pluginRepositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-coverage-minimum</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.15</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.basepom.maven</groupId>
                <artifactId>duplicate-finder-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>reject-duplicate-classes</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <failBuildInCaseOfDifferentContentConflict>true</failBuildInCaseOfDifferentContentConflict>
                            <failBuildInCaseOfEqualContentConflict>true</failBuildInCaseOfEqualContentConflict>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- JaCoCo supplies argLine late; Mockito must be loaded as an agent before tests start on JDK 25. -->
                        <argLine>@{argLine} -javaagent:${settings.localRepository}/org/mockito/mockito-core/${haunted.mockito.version}/mockito-core-${haunted.mockito.version}.jar --enable-native-access=ALL-UNNAMED</argLine>
                    </configuration>
                    <dependencies>
                        <!-- Resolve the exact agent artifact before the test JVM is forked in modules that do not use Mockito directly. -->
                        <dependency>
                            <groupId>org.mockito</groupId>
                            <artifactId>mockito-core</artifactId>
                            <version>${haunted.mockito.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- Release-only consumers compile against the public API and are exercised inside real platform processes. -->
        <profile>
            <id>platform-acceptance</id>
            <modules>
                <module>dataprovider-platform-acceptance</module>
            </modules>
        </profile>
    </profiles>
</project>
