<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>nl.hauntedmc.dataprovider</groupId>
        <artifactId>dataprovider-platform-acceptance</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>dataprovider-acceptance-consumer-paper</artifactId>
    <name>DataProvider Acceptance Consumer (Paper)</name>

    <dependencies>
        <!-- This fixture deliberately has no dependency on DataProvider Core or either platform implementation. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>dataprovider-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>
</project>
