<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>nl.hauntedmc.dataprovider</groupId>
        <artifactId>dataprovider-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>dataprovider-platform-acceptance</artifactId>
    <packaging>pom</packaging>
    <name>DataProvider Platform Acceptance Fixtures</name>

    <modules>
        <module>consumer-paper</module>
        <module>consumer-velocity</module>
        <!-- Must remain last: it boots the artifacts packaged by the preceding reactor modules. -->
        <module>runtime</module>
    </modules>

    <build>
        <!-- Consumers and their runner are verification fixtures, never published release coordinates. -->
        <plugins>
            <plugin>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
